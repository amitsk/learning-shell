#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: $(basename "$0") file1 file2" >&2
  exit 2
fi

for file in "$1" "$2"; do
  if [ ! -r "$file" ]; then
    echo "$(basename "$0"): cannot read $file" >&2
    exit 1
  fi
done

count1=$(wc -l < "$1")
count2=$(wc -l < "$2")

echo "$((count1 - count2))"
